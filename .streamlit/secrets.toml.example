# Copy one of the options below into Streamlit Cloud > App Settings > Secrets.
# Do not commit a real secrets.toml file or paste credentials into source code.

# Option 1 (Alternative if TMDB is unreachable): Free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY = "your_omdb_api_key"

# Option 2: TMDB credentials
# TMDB_READ_ACCESS_TOKEN = "your_tmdb_api_read_access_token"
# TMDB_API_KEY = "your_tmdb_v3_api_key"
